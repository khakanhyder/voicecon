{
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "shadcn": "^3.5.0",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui-chromium",
    "test:all-browsers": "playwright test --project=ui-chromium --project=ui-firefox --project=ui-webkit",
    "test:api": "E2E=1 playwright test --project=api",
    "test:e2e": "E2E=1 playwright test --project=e2e-setup --project=e2e",
    "test:full": "E2E=1 playwright test",
    "test:headed": "playwright test --project=ui-chromium --headed",
    "test:debug": "playwright test --project=ui-chromium --debug",
    "test:report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  }
}
