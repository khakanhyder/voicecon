# ── Core ──────────────────────────────────────────────────────────────────────
ENVIRONMENT=production
DEBUG=false
SECRET_KEY=your-very-long-random-secret-key-here

# ── Database (Railway MySQL) ───────────────────────────────────────────────────
# Railway sets this automatically when you add a MySQL service
DATABASE_URL=mysql://user:password@host:3306/railway

# ── CORS ──────────────────────────────────────────────────────────────────────
# Set to your Railway frontend URL
BACKEND_CORS_ORIGINS=["https://your-frontend.up.railway.app"]

# ── Email / SMTP ──────────────────────────────────────────────────────────────
# Powers sign-up verification codes, password-reset codes and team invitations.
# Leave the SMTP fields blank in dev: with no provider configured the app uses a
# console provider that LOGS emails instead of sending them. With DEBUG=true the
# sign-up and reset endpoints also return the code in the response body, so the
# flows are testable locally without a mail server.
#
# In production these must be real: without a working transport, nobody can
# create an account or reset a password.
#
# EMAIL_PROVIDER: auto (default) | smtp | sendgrid | console
#   auto → uses SMTP if SMTP_HOST is set, else SendGrid if SENDGRID_API_KEY is
#          set, else console (log-only). Set explicitly to force one.
EMAIL_PROVIDER=auto
# From identity used on all outbound mail.
EMAIL_FROM=no-reply@voicecon.app
EMAIL_FROM_NAME=Voicecon
# --- Option A: generic SMTP (works with Gmail, Mailgun, Postmark, SES, etc.) ---
# Port 587 = STARTTLS (SMTP_USE_TLS=true). Port 465 = implicit SSL (set
# SMTP_USE_SSL=true, SMTP_USE_TLS=false). Username/password are optional for
# relays that don't require auth.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
# --- Option B: SendGrid API (alternative to SMTP) ---
# SENDGRID_API_KEY=SG.xxxxx
# SENDGRID_FROM_EMAIL=no-reply@voicecon.app
# Sign-up must confirm the email address with an emailed code. Turn off only for
# automated tests or a closed demo — with it off, anyone can register an address
# they do not own.
REQUIRE_EMAIL_VERIFICATION=true

# ── Social Login (Google / Apple) ─────────────────────────────────────────────
# Public URL of the frontend (used as OAuth origin / Apple return base, and as
# the base for invitation Accept/Reject links — set this to your real frontend).
FRONTEND_URL=https://your-frontend.up.railway.app
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID (Web).
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Apple Developer → Certificates, IDs & Profiles. APPLE_CLIENT_ID is the Services ID
# (e.g. com.voicecon.web). TEAM_ID/KEY_ID/PRIVATE_KEY are only needed for the
# authorization-code exchange; pure sign-in verification needs only APPLE_CLIENT_ID.
APPLE_CLIENT_ID=com.yourcompany.web
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ── AI Providers ──────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
DEEPGRAM_API_KEY=...
ELEVENLABS_API_KEY=...

# ── Telephony ─────────────────────────────────────────────────────────────────
# Public HTTPS URL of this API. Purchased numbers get webhook URLs built from
# it, so buying a number is refused while it is unset. In dev, use your tunnel
# URL (e.g. https://your-tunnel.ngrok-free.app).
API_BASE_URL=
# Voicecon's own Twilio account — the default users buy numbers on when they
# have not brought their own. Set both values and "Twilio · Voicecon shared
# account" appears in the Purchase Number picker for every user; leave them
# blank and users must connect their own Twilio under Integrations first.
# Numbers bought here are billed to this account.
# Credentials: https://console.twilio.com → Account Info
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Optional fallback caller ID for outbound calls with no number assigned.
TWILIO_PHONE_NUMBER=

# Verify the X-Twilio-Signature on inbound webhooks. Signatures are checked
# against the account that owns the called number, so numbers bought on a
# user's own connected Twilio validate against their auth token.
TWILIO_VALIDATE_WEBHOOKS=true
# Public HTTPS base URL Twilio calls back on, when behind a proxy/tunnel
# (e.g. https://your-tunnel.ngrok-free.app). Signatures are computed over it.
TWILIO_PUBLIC_BASE_URL=

# ── Redis (optional) ──────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Stripe (Payments) ─────────────────────────────────────────────────────────
# Get these from https://dashboard.stripe.com/apikeys
# For local/dev use the TEST keys (sk_test_…, pk_test_…). Replace with LIVE keys
# (sk_live_…, pk_live_…) in production.
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
# Webhook signing secret from https://dashboard.stripe.com/webhooks (whsec_…)
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ── Mailchimp (Launching-Soon waitlist) ─────────────────────────────────────
# API key: Mailchimp → Account & billing → Extras → API keys (ends in -usXX).
MAILCHIMP_API_KEY=your_mailchimp_api_key_here-us21
# Audience (List) ID: Audience → Settings → Audience name and defaults → Audience ID.
MAILCHIMP_AUDIENCE_ID=your_audience_id_here
# Optional — auto-derived from the API key's -usXX suffix if left blank.
MAILCHIMP_SERVER_PREFIX=
