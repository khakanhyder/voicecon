# Testing
.coverage
# Per-process data files from parallel coverage runs. `.coverage` above is an
# exact filename and does not match these, so they showed up as untracked.
.coverage.*
coverage.xml
.pytest_cache/
# Python's HTML report (pytest --cov-report=html) and the JS one (vitest's
# html reporter, which writes frontend/coverage/). Both are regenerated by a
# single command, so they are output, never source.
htmlcov/
coverage/
.tox/
.hypothesis/

